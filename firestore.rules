rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAnonymousStudent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTeacher() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/teachers/$(request.auth.uid)
        ).data.active == true;
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isActiveAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        && get(/databases/$(database)/documents/admins/$(uid)).data.active == true;
    }

    function isAdmin() {
      return request.auth != null && isActiveAdmin(request.auth.uid);
    }

    function hasReviewLink(uid, action, eventId) {
      return eventId is string
        && eventId.size() >= 12
        && getAfter(
          /databases/$(database)/documents/teacherReviewHistory/$(eventId)
        ).data.targetUid == uid
        && getAfter(
          /databases/$(database)/documents/teacherReviewHistory/$(eventId)
        ).data.action == action
        && getAfter(
          /databases/$(database)/documents/teacherReviewHistory/$(eventId)
        ).data.reviewedBy == request.auth.uid;
    }

    // 10/22: the freeReview_* fields are one mark per free-practice principle (01-10).
    function hasExactProgressFields() {
      return request.resource.data.keys().hasAll([
        'academicYear', 'classId', 'seatNo', 'studentKey', 'updatedAt'
      ]) && request.resource.data.keys().hasOnly([
        'academicYear', 'classId', 'seatNo', 'studentKey', 'freeReviewComplete',
        'level1Complete', 'level2Complete', 'level3Complete', 'updatedAt',
        'freeReview_repetition', 'freeReview_gradation', 'freeReview_symmetry', 'freeReview_balance', 'freeReview_contrast', 'freeReview_rhythm', 'freeReview_proportion', 'freeReview_unity', 'freeReview_harmony', 'freeReview_simplicity'
      ]);
    }

    function hasAnyCheckpoint() {
      return request.resource.data.keys().hasAny([
        'freeReviewComplete', 'level1Complete', 'level2Complete', 'level3Complete',
        'freeReview_repetition', 'freeReview_gradation', 'freeReview_symmetry', 'freeReview_balance', 'freeReview_contrast', 'freeReview_rhythm', 'freeReview_proportion', 'freeReview_unity', 'freeReview_harmony', 'freeReview_simplicity'
      ]);
    }

    function hasOnlyTrueCheckpoints() {
      return request.resource.data.get('freeReviewComplete', true) == true
        && request.resource.data.get('level1Complete', true) == true
        && request.resource.data.get('level2Complete', true) == true
        && request.resource.data.get('level3Complete', true) == true
        && request.resource.data.get('freeReview_repetition', true) == true
        && request.resource.data.get('freeReview_gradation', true) == true
        && request.resource.data.get('freeReview_symmetry', true) == true
        && request.resource.data.get('freeReview_balance', true) == true
        && request.resource.data.get('freeReview_contrast', true) == true
        && request.resource.data.get('freeReview_rhythm', true) == true
        && request.resource.data.get('freeReview_proportion', true) == true
        && request.resource.data.get('freeReview_unity', true) == true
        && request.resource.data.get('freeReview_harmony', true) == true
        && request.resource.data.get('freeReview_simplicity', true) == true;
    }

    function preservesCompletedCheckpoints() {
      return (!('freeReviewComplete' in resource.data) || 'freeReviewComplete' in request.resource.data)
        && (!('level1Complete' in resource.data) || 'level1Complete' in request.resource.data)
        && (!('level2Complete' in resource.data) || 'level2Complete' in request.resource.data)
        && (!('level3Complete' in resource.data) || 'level3Complete' in request.resource.data)
        && (!('freeReview_repetition' in resource.data) || 'freeReview_repetition' in request.resource.data)
        && (!('freeReview_gradation' in resource.data) || 'freeReview_gradation' in request.resource.data)
        && (!('freeReview_symmetry' in resource.data) || 'freeReview_symmetry' in request.resource.data)
        && (!('freeReview_balance' in resource.data) || 'freeReview_balance' in request.resource.data)
        && (!('freeReview_contrast' in resource.data) || 'freeReview_contrast' in request.resource.data)
        && (!('freeReview_rhythm' in resource.data) || 'freeReview_rhythm' in request.resource.data)
        && (!('freeReview_proportion' in resource.data) || 'freeReview_proportion' in request.resource.data)
        && (!('freeReview_unity' in resource.data) || 'freeReview_unity' in request.resource.data)
        && (!('freeReview_harmony' in resource.data) || 'freeReview_harmony' in request.resource.data)
        && (!('freeReview_simplicity' in resource.data) || 'freeReview_simplicity' in request.resource.data);
    }

    function hasValidIdentity(studentKey) {
      return request.resource.data.academicYear is string
        && request.resource.data.academicYear.matches('[0-9]+')
        && request.resource.data.classId is string
        && request.resource.data.classId.matches('[0-9]{3}')
        && request.resource.data.seatNo is int
        && request.resource.data.seatNo > 0
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey == studentKey
        && studentKey == request.resource.data.academicYear + '-' + request.resource.data.classId + '-' + string(request.resource.data.seatNo);
    }

    function hasServerTimestamp() {
      return request.resource.data.updatedAt == request.time;
    }

    match /studentProgress/{studentKey} {
      allow get, list: if isTeacher();
      allow delete: if false;

      allow create: if isAnonymousStudent()
        && hasExactProgressFields()
        && hasValidIdentity(studentKey)
        && hasAnyCheckpoint()
        && hasOnlyTrueCheckpoints()
        && hasServerTimestamp();

      allow update: if isAnonymousStudent()
        && hasExactProgressFields()
        && hasValidIdentity(studentKey)
        && request.resource.data.academicYear == resource.data.academicYear
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.seatNo == resource.data.seatNo
        && request.resource.data.studentKey == resource.data.studentKey
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['freeReviewComplete', 'level1Complete', 'level2Complete', 'level3Complete', 'updatedAt',
            'freeReview_repetition', 'freeReview_gradation', 'freeReview_symmetry', 'freeReview_balance', 'freeReview_contrast', 'freeReview_rhythm', 'freeReview_proportion', 'freeReview_unity', 'freeReview_harmony', 'freeReview_simplicity'])
        && hasAnyCheckpoint()
        && hasOnlyTrueCheckpoints()
        && preservesCompletedCheckpoints()
        && hasServerTimestamp();
    }

    function hasValidClassConfig(classConfigKey) {
      return request.resource.data.keys().hasAll([
        'academicYear', 'classId', 'active', 'validSeatNumbers', 'updatedAt'
      ]) && request.resource.data.keys().hasOnly([
        'academicYear', 'classId', 'active', 'validSeatNumbers', 'updatedAt'
      ])
        && request.resource.data.academicYear is string
        && request.resource.data.academicYear.matches('[0-9]+')
        && request.resource.data.classId is string
        && request.resource.data.classId.matches('[0-9]{3}')
        && request.resource.data.active is bool
        && request.resource.data.validSeatNumbers is list
        && request.resource.data.validSeatNumbers.size() <= 200
        && request.resource.data.validSeatNumbers.toSet().size() == request.resource.data.validSeatNumbers.size()
        && classConfigKey == request.resource.data.academicYear + '-' + request.resource.data.classId
        && request.resource.data.updatedAt == request.time;
    }

    match /classConfigs/{classConfigKey} {
      allow get, list: if isAnonymousStudent() || isTeacher();
      allow create: if isTeacher() && hasValidClassConfig(classConfigKey);
      allow update: if isTeacher()
        && hasValidClassConfig(classConfigKey)
        && request.resource.data.academicYear == resource.data.academicYear
        && request.resource.data.classId == resource.data.classId;
      allow delete: if false;
    }

    function hasValidAcademicYear(academicYear) {
      return request.resource.data.keys().hasAll([
        'academicYear', 'status', 'createdAt', 'updatedAt'
      ]) && request.resource.data.keys().hasOnly([
        'academicYear', 'status', 'createdAt', 'updatedAt'
      ])
        && request.resource.data.academicYear is string
        && request.resource.data.academicYear.matches('[0-9]{2,4}')
        && request.resource.data.academicYear == academicYear
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.updatedAt == request.time;
    }

    match /academicYears/{academicYear} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && hasValidAcademicYear(academicYear)
        && request.resource.data.createdAt == request.time;
      allow update: if isTeacher()
        && hasValidAcademicYear(academicYear)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function hasValidAcademicYearSettings() {
      return request.resource.data.keys().hasAll(['activeAcademicYear', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['activeAcademicYear', 'updatedAt'])
        && request.resource.data.activeAcademicYear is string
        && request.resource.data.activeAcademicYear.matches('[0-9]{2,4}')
        && request.resource.data.updatedAt == request.time;
    }

    match /appSettings/academicYear {
      allow read: if isAnonymousStudent() || isTeacher();
      allow create, update: if isTeacher() && hasValidAcademicYearSettings();
      allow delete: if false;
    }

    function hasValidApplicationCreate(uid) {
      return isGoogleUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName == request.auth.token.name
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidApplicationDecision(uid) {
      return request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'status', 'createdAt', 'updatedAt',
          'reviewedAt', 'reviewedBy', 'lastReviewId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reviewedAt', 'reviewedBy', 'lastReviewId'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['approved', 'rejected', 'revoked']
        && (request.resource.data.status != 'revoked' || !isActiveAdmin(uid))
        && (
          (resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.status == 'approved' && request.resource.data.status == 'revoked')
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && hasReviewLink(uid, request.resource.data.status, request.resource.data.lastReviewId)
        && (
          request.resource.data.status == 'rejected'
          || (
            request.resource.data.status == 'approved'
            && getAfter(/databases/$(database)/documents/teachers/$(uid)).data.active == true
            && getAfter(/databases/$(database)/documents/teachers/$(uid)).data.lastReviewId
              == request.resource.data.lastReviewId
          )
          || (
            request.resource.data.status == 'revoked'
            && getAfter(/databases/$(database)/documents/teachers/$(uid)).data.active == false
            && getAfter(/databases/$(database)/documents/teachers/$(uid)).data.lastReviewId
              == request.resource.data.lastReviewId
          )
        );
    }

    function hasValidLegacyRevocationApplication(uid) {
      return isAdmin()
        && !isActiveAdmin(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'status', 'createdAt', 'updatedAt',
          'reviewedAt', 'reviewedBy', 'lastReviewId'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'status', 'createdAt', 'updatedAt',
          'reviewedAt', 'reviewedBy', 'lastReviewId'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.status == 'revoked'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && hasReviewLink(uid, 'revoked', request.resource.data.lastReviewId)
        && get(/databases/$(database)/documents/teachers/$(uid)).data.active == true
        && getAfter(/databases/$(database)/documents/teachers/$(uid)).data.active == false
        && getAfter(/databases/$(database)/documents/teachers/$(uid)).data.lastReviewId
          == request.resource.data.lastReviewId;
    }

    match /teacherApplications/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if hasValidApplicationCreate(uid) || hasValidLegacyRevocationApplication(uid);
      allow update: if isAdmin() && hasValidApplicationDecision(uid);
      allow delete: if false;
    }

    function hasValidTeacherApproval(uid) {
      return request.resource.data.active == true
        && request.resource.data.updatedAt == request.time
        && request.resource.data.approvedAt == request.time
        && request.resource.data.approvedBy == request.auth.uid
        && hasReviewLink(uid, 'approved', request.resource.data.lastReviewId)
        && getAfter(/databases/$(database)/documents/teacherApplications/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/teacherApplications/$(uid)).data.lastReviewId
          == request.resource.data.lastReviewId;
    }

    function hasValidTeacherRevocation(uid) {
      return !isActiveAdmin(uid)
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revokedAt == request.time
        && request.resource.data.revokedBy == request.auth.uid
        && hasReviewLink(uid, 'revoked', request.resource.data.lastReviewId)
        && (
          !existsAfter(/databases/$(database)/documents/teacherApplications/$(uid))
          || (
            getAfter(/databases/$(database)/documents/teacherApplications/$(uid)).data.status == 'revoked'
            && getAfter(/databases/$(database)/documents/teacherApplications/$(uid)).data.lastReviewId
              == request.resource.data.lastReviewId
          )
        );
    }

    match /teachers/{uid} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'active', 'displayName', 'email', 'approvedAt', 'approvedBy', 'updatedAt', 'lastReviewId'
        ])
        && request.resource.data.keys().hasOnly([
          'active', 'displayName', 'email', 'approvedAt', 'approvedBy', 'updatedAt', 'lastReviewId'
        ])
        && hasValidTeacherApproval(uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'displayName', 'email', 'approvedAt', 'approvedBy',
          'revokedAt', 'revokedBy', 'updatedAt', 'lastReviewId'
        ])
        && (hasValidTeacherApproval(uid) || hasValidTeacherRevocation(uid));
      allow delete: if false;
    }

    function hasValidReviewHistory(eventId) {
      return request.resource.data.keys().hasAll([
          'targetUid', 'action', 'reviewedBy', 'reviewedAt', 'previousStatus', 'nextStatus'
        ])
        && request.resource.data.keys().hasOnly([
          'targetUid', 'action', 'reviewedBy', 'reviewedAt', 'previousStatus', 'nextStatus'
        ])
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.action in ['approved', 'rejected', 'revoked']
        && (request.resource.data.action != 'revoked'
          || !isActiveAdmin(request.resource.data.targetUid))
        && request.resource.data.nextStatus == request.resource.data.action
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (
          (
            request.resource.data.action in ['approved', 'rejected']
            && request.resource.data.previousStatus == 'pending'
            && get(
              /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
            ).data.status == 'pending'
            && getAfter(
              /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
            ).data.status == request.resource.data.action
            && getAfter(
              /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
            ).data.lastReviewId == eventId
          )
          || (
            request.resource.data.action == 'revoked'
            && request.resource.data.previousStatus in ['approved', 'teacher-only']
            && get(
              /databases/$(database)/documents/teachers/$(request.resource.data.targetUid)
            ).data.active == true
            && getAfter(
              /databases/$(database)/documents/teachers/$(request.resource.data.targetUid)
            ).data.active == false
            && getAfter(
              /databases/$(database)/documents/teachers/$(request.resource.data.targetUid)
            ).data.lastReviewId == eventId
            && (
              (
                request.resource.data.previousStatus == 'teacher-only'
                && !exists(
                  /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
                )
                && getAfter(
                  /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
                ).data.status == 'revoked'
                && getAfter(
                  /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
                ).data.lastReviewId == eventId
              )
              || (
                request.resource.data.previousStatus == 'approved'
                && get(
                  /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
                ).data.status == 'approved'
                && getAfter(
                  /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
                ).data.status == 'revoked'
                && getAfter(
                  /databases/$(database)/documents/teacherApplications/$(request.resource.data.targetUid)
                ).data.lastReviewId == eventId
              )
            )
          )
        );
    }

    match /teacherReviewHistory/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && hasValidReviewHistory(eventId);
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /adminProtectionProbes/{uid} {
      allow get: if isAdmin() && isActiveAdmin(uid);
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
