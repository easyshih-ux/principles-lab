rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasExactProgressFields() {
      return request.resource.data.keys().hasAll([
        'classId', 'seatNo', 'studentKey', 'testCheckpointComplete', 'updatedAt'
      ]) && request.resource.data.keys().hasOnly([
        'classId', 'seatNo', 'studentKey', 'testCheckpointComplete', 'updatedAt'
      ]);
    }

    function hasValidIdentity(studentKey) {
      return request.resource.data.classId is string
        && request.resource.data.classId.matches('[0-9]{3}')
        && request.resource.data.seatNo is int
        && request.resource.data.seatNo > 0
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey == studentKey
        && studentKey == request.resource.data.classId + '-' + string(request.resource.data.seatNo);
    }

    function hasServerTimestamp() {
      return request.resource.data.updatedAt == request.time;
    }

    match /studentProgress/{studentKey} {
      allow get, list, delete: if false;

      allow create: if isAuthenticated()
        && hasExactProgressFields()
        && hasValidIdentity(studentKey)
        && request.resource.data.testCheckpointComplete == true
        && hasServerTimestamp();

      allow update: if isAuthenticated()
        && hasExactProgressFields()
        && hasValidIdentity(studentKey)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.seatNo == resource.data.seatNo
        && request.resource.data.studentKey == resource.data.studentKey
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['testCheckpointComplete', 'updatedAt'])
        && request.resource.data.testCheckpointComplete == true
        && (resource.data.testCheckpointComplete == false
          || resource.data.testCheckpointComplete == true)
        && hasServerTimestamp();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
